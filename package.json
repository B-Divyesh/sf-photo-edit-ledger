{
  "name": "photo-edit-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.js",
    "test": "cargo test --all-targets && node --test site/tests/*.test.mjs",
    "test:a11y": "node site/tests/a11y.mjs",
    "build:cli": "cargo build --release --locked",
    "package:cli": "cargo package --locked",
    "build:site": "vite build --config site/vite.config.js",
    "build": "npm test && npm run build:cli && npm run package:cli && npm run build:site"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1",
    "vite": "^7.1.3"
  }
}
